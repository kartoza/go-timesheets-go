#!/usr/bin/env bash

# Kartoza Timesheet App - Development Environment
# This file is used by direnv to automatically load the Nix flake environment

if ! has nix_direnv_version || ! nix_direnv_version 3.0.4; then
  source_url "https://raw.githubusercontent.com/nix-community/nix-direnv/3.0.4/direnvrc" "sha256-DzlYZ33mWF/Gs8DDeyjr8mnVmQGx7ASYqA5WlxwvBG4="
fi

# Use the flake development shell
use flake

# Additional environment setup
export PROJECT_ROOT="$(pwd)"
export GOPATH="${PROJECT_ROOT}/.go"
export GOCACHE="${PROJECT_ROOT}/.cache/go-build"
export GOMODCACHE="${PROJECT_ROOT}/.cache/go-mod"

# Ensure Go directories exist
mkdir -p "${GOPATH}" "${GOCACHE}" "${GOMODCACHE}"

# Add project bin to PATH
PATH_add "${PROJECT_ROOT}/bin"
PATH_add "${GOPATH}/bin"

# Set up development tools
export EDITOR=nvim
export VISUAL=nvim

log_status "🚀 Kartoza Timesheet App development environment loaded"
log_status "💡 Run 'nix run .#setup' to initialize Go module and install Bubbletea"